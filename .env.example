# Copy to `.env` for local development (`next dev` reads it, and so does
# `opennextjs-cloudflare preview` via initOpenNextCloudflareForDev).
#
# For the deployed Worker these split in two:
#   - NEXT_PUBLIC_* are inlined into the bundle at BUILD time, so they must be
#     set wherever the build runs (Workers Builds -> "Build variables and
#     secrets", or your CI). Setting them only as Worker vars is too late.
#   - everything else is read at RUNTIME. There are no Worker secrets today.
#
# The ingest jobs run as Supabase Edge Functions, not in this app. They get
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY injected by the platform, so nothing
# here is needed for them. Their one optional secret is set on Supabase:
#   npx supabase secrets set NASA_FIRMS_MAP_KEY=... --project-ref <ref>

# Supabase (historical hazard storage + community "did you feel it" reports)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: bypasses RLS, used by the read routes (/api/trends,
# /api/hazards, /api/cyclone-history, /api/quake/[id]). Never expose to the
# client. Set as a Worker secret in production:
#   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# Public URL used for canonical links / embed instructions. Keep in sync with
# the `vars.NEXT_PUBLIC_APP_URL` entry in wrangler.jsonc.
NEXT_PUBLIC_APP_URL=https://seismicmonitor.contact-ahmedsakib.workers.dev

# Optional: Cloudflare Web Analytics beacon token, replacing the old Vercel
# Analytics/Speed Insights pair. Leave empty to render no beacon at all.
# Not needed on a custom domain proxied through Cloudflare with Web Analytics
# enabled in the dashboard -- that injects the beacon for you.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Optional: alternate FDSN-compatible earthquake feed used when
# source=secondary is passed to /api/earthquakes. Currently unused by any
# UI in this app -- unset unless you have a specific secondary feed.
SECONDARY_FDSN_QUERY_URL=

# Note: push notifications (OneSignal) were removed in an earlier pass and will
# be rebuilt with a provider later. No notification env vars are needed now.
