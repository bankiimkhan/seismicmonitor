# Supabase (historical earthquake storage + community "did you feel it" reports)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: bypasses RLS, used by /api/ingest and /api/trends. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL used for canonical links / embed instructions
NEXT_PUBLIC_APP_URL=https://bd-earthquakes.vercel.app

# Shared secret required by /api/ingest. Vercel Cron automatically sends this
# as `Authorization: Bearer $CRON_SECRET` when this env var is set on the
# project, so no manual wiring is needed for the cron in vercel.json.
# For any other caller (manual testing, an external scheduler), send the
# same value as an `Authorization: Bearer <secret>` header.
CRON_SECRET=

# Optional: alternate FDSN-compatible earthquake feed used when
# source=secondary is passed to /api/earthquakes. Currently unused by any
# UI in this app -- unset unless you have a specific secondary feed.
SECONDARY_FDSN_QUERY_URL=

# Note: push notifications (OneSignal) were removed in this pass and will be
# rebuilt with a provider later. No notification-related env vars are needed
# right now.
