{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "seismicmonitor",
    // Straight to the adapter's generated entrypoint. There was briefly a
    // custom worker.ts here wrapping this with a `scheduled` handler, back when
    // the ingest jobs ran as Cloudflare Cron Triggers -- they now run as
    // Supabase Edge Functions on pg_cron (Workers Free caps subrequests at
    // 50/invocation and cron CPU at 10ms, neither of which the ingest run
    // fits), so there is nothing left to wrap.
    "main": ".open-next/worker.js",
    // Must not exceed the date of the workerd build bundled with the installed
    // wrangler, or local dev refuses to start ("is in the future and
    // unsupported"). Bump this alongside wrangler, not on its own.
    "compatibility_date": "2026-07-30",
    // nodejs_compat: required by @opennextjs/cloudflare (Next's server pulls in
    // node builtins). global_fetch_strictly_public: makes fetch() to our own
    // hostname go out through the CDN instead of looping back into this Worker,
    // which is what the adapter expects.
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    // The app is served from a custom domain on the bankiim.me zone. This was
    // configured in the dashboard and NOT recorded here, which made it a
    // deletion candidate: `wrangler deploy` overwrites remote config with this
    // file, and anything present remotely but missing here shows up in the
    // pre-deploy diff as a removal. Declared here so the deploy is idempotent
    // and the routing lives in version control with everything else.
    "routes": [
        {
            "pattern": "seismic-monitor.bankiim.me",
            "zone_name": "bankiim.me",
            "custom_domain": true
        }
    ],
    // Both default to true the moment they are absent from this file, so
    // leaving them out silently re-enabled a second public origin
    // (seismicmonitor.<subdomain>.workers.dev) alongside the custom domain --
    // duplicate content, and an origin that bypasses anything bound to the
    // zone. Off, explicitly.
    "workers_dev": false,
    "preview_urls": false,
    "observability": {
        "enabled": true
    },
    // Backs Next's data cache (the `next: { revalidate }` fetches in
    // lib/earthquakes.ts). Without an incremental cache override every request
    // re-hits USGS/NCS directly. Create it once before the first deploy:
    //   npx wrangler r2 bucket create seismicmonitor-cache
    "r2_buckets": [
        {
            "binding": "NEXT_INC_CACHE_R2_BUCKET",
            "bucket_name": "seismicmonitor-cache"
        }
    ],
    "vars": {
        // Runtime copy. The *client* bundle gets its own copy inlined at build
        // time from .env -- setting it here does not cover that, so keep the
        // two in sync (see .env.example).
        // No trailing slash: every consumer appends a path (`${APP_URL}/embed`
        // in /about's iframe snippet), so a trailing slash produced a `//embed`
        // URL that Next answers with a 308 redirect -- a wasted hop inside a
        // third party's iframe.
        "NEXT_PUBLIC_APP_URL": "https://seismic-monitor.bankiim.me"
    }
}
